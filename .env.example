# ───────────────────────────────────────────────────────────────────────────────
# Curbside Commons — Menu Integrity Crew — environment template (TRACKED; no real secrets).
#
# HOW TO USE (the "space to paste your keys"):
#   1. Copy this file to `.env`            →  cp .env.example .env
#      (If `.env` already exists, DON'T overwrite it — just open it and add/update
#       the keys below. `.env` holds your real keys and is gitignored.)
#   2. Open `.env` in your editor and paste your real keys after the `=` signs.
#   3. NEVER paste a real key into chat, a commit, a log, or a screenshot (RULES §11).
#      `.env` is gitignored (.gitignore: `.env`, `.env*.local`) and must stay untracked.
#
# Verify before any live run:   git check-ignore .env   (must print ".env")
#                               git status               (must NOT list .env)
#
# COST: free tiers only (decision 2026-10-12). An absent key means replay mode, $0.
# This template lists exactly the variables the code reads today; every value below
# is blank on purpose, and a blank value means "use the built-in default".
# ───────────────────────────────────────────────────────────────────────────────

# ── MASTER SWITCH ────────────────────────────────────────────────────────────────

# The one switch for every live model call. Blank = off, which is also how the public
# site runs (replay only, can never spend). Set it to `true` only for an intentional
# live run; it still needs the matching key below.
ENABLE_LIVE_AI=

# ── API KEYS (paste yours into .env, never here) ─────────────────────────────────

# Groq — free tier. Used by the crew's live model lane and the fee-statement classifier.
# Get one at https://console.groq.com/keys . Blank = replay, $0.
GROQ_API_KEY=

# Gemini — Google AI Studio free tier. Used only by the optional Gemini helper.
# Get one at https://aistudio.google.com/apikey . Blank = replay, $0.
GEMINI_API_KEY=

# ── OPTIONAL MODEL OVERRIDES (blank = the code's own default) ────────────────────
# Model ids change, so check them against the provider's current docs before you
# set one (RULES §6); never copy an id from memory.
CREW_LIVE_MODEL=
FEE_CLASSIFIER_MODEL=
GROQ_DRAFT_MODEL=
GEMINI_MODEL=
JUDGE_MODEL=

# Which provider's key unlocks the two optional check lanes. Blank = groq, which is
# the right choice for almost everyone.
JUDGE_PROVIDER=
DOMAIN_JUDGE_PROVIDER=

# ── SEND DEMOS (owner-armed, one send per owner word, simulated banner enforced) ──
# These belong to the two one-shot scripts in scripts-ts/. The site, the command line
# and the MCP server have no send path at all. Blank = the demo stays unarmed.
#   node --env-file=.env scripts-ts/l2-slack-one-shot.mts
#   node --env-file=.env scripts-ts/l2-resend-one-shot.mts

# Slack incoming webhook for YOUR OWN channel. Must start with
# https://hooks.slack.com/services/ — the sender refuses anything else.
SLACK_WEBHOOK_URL=

# Resend email: an API key (starts re_), a recipient YOU own (with the default test
# sender this must be your Resend account address), and an optional sender line.
RESEND_API_KEY=
RESEND_TO=
RESEND_FROM=

# ── BUILD AND SCRIPT SETTINGS (rarely needed; blank = the script's default) ───────

# Stamped into the build by the build script; set by CI or the build, not by hand.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME_UTC=

# Output folder for one crew consistency run (crew-live-l1-run.mts), e.g. consistency/rep-1.
L1_OUT_DIR=

# Set to 1 to let the UCP oracle script run `cargo install ucp-schema` (opt-in).
UCP_ORACLE_INSTALL=

# Pricing-snapshot freshness date (ISO, e.g. 2026-10-31); informational.
FETCHED_AT=

# ═════════════════════════════════════════════════════════════════════════════════
# QUICK SETUPS
#
#  • Default (no keys): everything runs in replay at $0. Nothing below is needed.
#
#  • Live crew run on Groq's free tier (owner-armed, labeled demonstration):
#       GROQ_API_KEY=<your groq key>
#       ENABLE_LIVE_AI=true
# ═════════════════════════════════════════════════════════════════════════════════
