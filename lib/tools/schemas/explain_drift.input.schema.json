{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activationops.local/tools/explain_drift.input.schema.json",
  "title": "explain_drift input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "events",
    "asOf"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "category",
          "referenceRowId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "referenceRowId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "actor",
          "action",
          "target"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "enum": [
              "merchant",
              "integrator",
              "platform",
              "unknown"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "price_edit",
              "86",
              "un86",
              "sync",
              "override"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    }
  }
}
