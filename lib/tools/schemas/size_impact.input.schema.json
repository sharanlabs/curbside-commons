{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activationops.local/tools/size_impact.input.schema.json",
  "title": "size_impact input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "orders",
    "windowDays",
    "errorChargeShare"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "category",
          "referenceRowId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "referenceRowId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "orders": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id",
          "placed_at",
          "channel",
          "lines",
          "status",
          "refund_cents",
          "refund_allocation",
          "reason"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "placed_at": {
            "type": "string",
            "format": "date-time"
          },
          "channel": {
            "type": "string",
            "enum": [
              "app",
              "agent"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variation_id",
                "modifier_option_ids",
                "qty",
                "unit_price_cents_charged"
              ],
              "properties": {
                "variation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "modifier_option_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit_price_cents_charged": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "fulfilled",
              "refunded",
              "cancelled"
            ]
          },
          "refund_cents": {
            "type": "integer",
            "minimum": 0
          },
          "refund_allocation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variation_id",
                "cents"
              ],
              "properties": {
                "variation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cents": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "enum": [
              "menu",
              "other",
              "none"
            ]
          }
        }
      }
    },
    "windowDays": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "errorChargeShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
